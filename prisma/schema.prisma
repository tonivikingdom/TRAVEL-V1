generator client {
  provider = "prisma-client"
  output   = "../packages/persistence/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  CONSUMED
  REVOKED
}

enum JobType {
  MAGIC_LINK_EMAIL
  FLIGHT_MONITOR
}

enum FlightMonitorMode {
  NORMAL
  DELAYED
  CANCELLED
  BAGGAGE
  STOPPED
}

enum NotificationPriority {
  NORMAL
  STRONG
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum MagicLinkDeliveryStatus {
  PENDING
  TOKEN_READY
  DELIVERED
  NOOP
}

enum StoredObjectState {
  PENDING
  READY
  FAILED
  DELETED
}

enum ItineraryNodeKind {
  PLACE_VISIT
  FREE_ACTION
}

enum ItineraryNodeSource {
  USER_PLANNED
  ROUTE_GENERATED
}

enum TransportMode {
  WALKING
  DRIVING
  TAXI
  RAIL
  BUS
  FERRY
  FLIGHT
  OTHER
}

enum TransportSource {
  MANUAL
  ADOPTED_ROUTE
}

enum AdoptedRouteStatus {
  ACTIVE
  REPLACED
  UNDONE
}

enum TransportDayProjectionRole {
  SAME_DAY
  START
  OCCUPIED
  END
}

enum OperationType {
  ROUTE_ADOPT
  ROUTE_UNDO
}

enum OutboxEventType {
  ROUTE_ADOPTED
  ROUTE_UNDONE
}

enum TransportInvalidationReason {
  ADJACENCY_CHANGED
  ENDPOINT_REPLACED
  NODE_DELETED
  USER_REPLACED
  USER_CLEARED
}

enum TemporalLayer {
  PLANNED
  ESTIMATED
  ACTUAL
}

enum TemporalPointKind {
  ARRIVAL
  DEPARTURE
}

enum TemporalSourceKind {
  USER_VALUE
  ADOPTED_TRANSPORT_FACT
  SYSTEM_SUGGESTION
  DERIVED
  PROVIDER_OBSERVATION
  EXECUTION_OBSERVATION
}

enum ExecutionEventType {
  ARRIVAL
  DEPARTURE
  SKIP_CONFIRMED
}

enum ExecutionEventSource {
  LOCATION
  MANUAL
}

enum NodeExecutionStatus {
  POSSIBLY_SKIPPED
  SKIPPED
}

enum ExecutionLocationStatus {
  RELIABLE
  INDETERMINATE
}

enum UserTimeIntentKind {
  POINT_TIME
  MIN_DWELL
}

enum UserTimeIntentOperator {
  EXACT
  NOT_BEFORE
  NOT_AFTER
  MINIMUM
}

enum DwellSuggestionSource {
  SYSTEM_SUGGESTION
}

enum ExecutionRiskKind {
  PROTECTED_TIME_AT_RISK
  PROTECTED_TIME_INFEASIBLE
  FIXED_SERVICE_MISSED
  BUFFER_BELOW_SYSTEM_MINIMUM
  UNKNOWN_EXECUTION_MARGIN
}

enum ExecutionRiskSeverity {
  EXECUTABLE_RISK
  INFEASIBLE
  UNKNOWN
}

enum ExecutionRiskStatus {
  OPEN
  ACKNOWLEDGED
  SNOOZED
  RESOLVED
}

enum FlightStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  EN_ROUTE
  LANDED
  ARRIVED
  DELAYED
  CANCELLED
  DIVERTED
  UNKNOWN
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String
  normalizedEmail         String                   @unique
  role                    UserRole                 @default(USER)
  status                  UserStatus               @default(ACTIVE)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  invitationsSent         Invitation[]             @relation("InvitationInviter")
  magicLinkTokens         MagicLinkToken[]
  sessions                Session[]
  preference              UserPreference?
  notifications           NotificationEvent[]
  storedObjects           StoredObject[]
  trips                   Trip[]
  places                  Place[]
  dateOwnerships          DateOwnership[]
  routeCandidateSnapshots RouteCandidateSnapshot[]
  routePreviews           RoutePreview[]
  operationReceipts       OperationReceipt[]
  executionRisks          ExecutionRisk[]
  flightBindings          FlightBinding[]
  executionEvents         ExecutionEvent[]

  @@index([status])
}

model NotificationEvent {
  id                  String               @id @default(uuid()) @db.Uuid
  ownerUserId         String               @db.Uuid
  kind                String               @db.VarChar(100)
  dedupeKey           String               @db.VarChar(200)
  title               String               @db.VarChar(200)
  body                String               @db.VarChar(4000)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  occurredAt          DateTime             @db.Timestamptz(3)
  dismissedAt         DateTime?            @db.Timestamptz(3)
  tripId              String?              @db.Uuid
  flightBindingId     String?              @db.Uuid
  flightNumber        String?              @db.VarChar(32)
  priority            NotificationPriority @default(NORMAL)
  summary             String?              @db.VarChar(500)
  changeKinds         Json                 @default("[]") @db.JsonB
  hasDownstreamImpact Boolean              @default(false)
  viewedAt            DateTime?            @db.Timestamptz(3)
  owner               User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, dedupeKey])
  @@index([ownerUserId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([ownerUserId, dismissedAt])
  @@index([flightBindingId, createdAt(sort: Desc)])
}

model StoredObject {
  id               String            @id @default(uuid()) @db.Uuid
  ownerUserId      String            @db.Uuid
  storageKey       String            @unique @db.VarChar(64)
  state            StoredObjectState @default(PENDING)
  displayName      String            @db.VarChar(255)
  mediaType        String            @db.VarChar(127)
  declaredByteSize BigInt
  byteSize         BigInt?
  sha256           String?           @db.VarChar(64)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  readyAt          DateTime?         @db.Timestamptz(3)
  deletedAt        DateTime?         @db.Timestamptz(3)
  owner            User              @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, state, createdAt])
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  email           String
  normalizedEmail String           @unique
  invitedByUserId String           @db.Uuid
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  consumedAt      DateTime?        @db.Timestamptz(3)
  revokedAt       DateTime?        @db.Timestamptz(3)
  invitedBy       User             @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  magicLinkTokens MagicLinkToken[]

  @@index([status, expiresAt])
}

model MagicLinkToken {
  id                String                    @id @default(uuid()) @db.Uuid
  userId            String?                   @db.Uuid
  invitationId      String?                   @db.Uuid
  deliveryRequestId String?                   @unique @db.Uuid
  tokenDigest       String                    @unique @db.VarChar(64)
  expiresAt         DateTime                  @db.Timestamptz(3)
  consumedAt        DateTime?                 @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  user              User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation        Invitation?               @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  deliveryRequest   MagicLinkDeliveryRequest? @relation(fields: [deliveryRequestId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenDigest String    @unique @db.VarChar(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  lastSeenAt  DateTime? @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model UserPreference {
  userId       String   @id @db.Uuid
  baseCurrency String   @default("CNY") @db.VarChar(3)
  uiLanguage   String   @default("zh-CN") @db.VarChar(35)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MagicLinkRequestBucket {
  keyDigest       String   @id @db.VarChar(64)
  windowStartedAt DateTime @db.Timestamptz(3)
  requestCount    Int
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}

model MagicLinkDeliveryRequest {
  id              String                  @id @default(uuid()) @db.Uuid
  normalizedEmail String
  requestedEmail  String
  requestedAt     DateTime                @db.Timestamptz(3)
  status          MagicLinkDeliveryStatus @default(PENDING)
  tokenGeneration Int                     @default(0)
  tokenExpiresAt  DateTime?               @db.Timestamptz(3)
  processedAt     DateTime?               @db.Timestamptz(3)
  magicLinkToken  MagicLinkToken?

  @@index([status, requestedAt])
}

model Job {
  id              String    @id @default(uuid()) @db.Uuid
  type            JobType
  status          JobStatus @default(QUEUED)
  runAt           DateTime  @db.Timestamptz(3)
  attempts        Int       @default(0)
  maxAttempts     Int
  leaseOwner      String?   @db.VarChar(128)
  leaseUntil      DateTime? @db.Timestamptz(3)
  uniqueKey       String    @unique @db.VarChar(200)
  payloadRef      String    @db.Uuid
  cancelRequested Boolean   @default(false)
  lastErrorCode   String?   @db.VarChar(64)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  completedAt     DateTime? @db.Timestamptz(3)
  cancelledAt     DateTime? @db.Timestamptz(3)

  @@index([status, runAt, leaseUntil])
  @@index([payloadRef])
}

model Trip {
  id                      String                   @id @default(uuid()) @db.Uuid
  ownerUserId             String                   @db.Uuid
  name                    String                   @db.VarChar(200)
  planningAnchorDate      DateTime                 @db.Date
  defaultPeopleCount      Int
  version                 Int                      @default(1)
  effectiveStartDate      DateTime?                @db.Date
  effectiveEndDate        DateTime?                @db.Date
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  owner                   User                     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  dateOwnerships          DateOwnership[]
  dayOccurrences          DayOccurrence[]
  nodes                   ItineraryNode[]
  transportEdges          TransportEdge[]
  transportHistory        TransportEdgeHistory[]
  timeIntents             UserTimeIntent[]
  dwellSuggestions        SystemDwellSuggestion[]
  routeCandidateSnapshots RouteCandidateSnapshot[]
  routePreviews           RoutePreview[]
  adoptedRoutes           AdoptedRoute[]
  transportDayProjections TransportDayProjection[]
  operationReceipts       OperationReceipt[]
  outboxEvents            OutboxEvent[]
  executionRisks          ExecutionRisk[]
  flightBindings          FlightBinding[]
  executionEvents         ExecutionEvent[]
  executionLocationState  ExecutionLocationState?

  @@unique([id, ownerUserId])
  @@index([ownerUserId, updatedAt(sort: Desc), id(sort: Desc)])
}

model ExecutionRisk {
  id                         String                @id @default(uuid()) @db.Uuid
  ownerUserId                String                @db.Uuid
  tripId                     String                @db.Uuid
  fingerprint                String                @db.VarChar(64)
  lifecycleGeneration        Int                   @default(1)
  kind                       ExecutionRiskKind
  severity                   ExecutionRiskSeverity
  status                     ExecutionRiskStatus   @default(OPEN)
  sourceNodeId               String?               @db.Uuid
  sourceTransportEdgeId      String?               @db.Uuid
  protectedNodeId            String?               @db.Uuid
  protectedTransportEdgeId   String?               @db.Uuid
  firstSeenAt                DateTime              @db.Timestamptz(3)
  lastSeenAt                 DateTime              @db.Timestamptz(3)
  acknowledgedAt             DateTime?             @db.Timestamptz(3)
  snoozedUntil               DateTime?             @db.Timestamptz(3)
  resolvedAt                 DateTime?             @db.Timestamptz(3)
  evaluationBasisTripVersion Int
  lastEvidenceHash           String                @db.VarChar(64)
  evidenceRefs               Json                  @db.JsonB
  requiresRouteReevaluation  Boolean               @default(false)
  notificationGeneration     Int                   @default(0)
  createdAt                  DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime              @updatedAt @db.Timestamptz(3)
  owner                      User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trip                       Trip                  @relation(fields: [tripId, ownerUserId], references: [id, ownerUserId], onDelete: Cascade)

  @@unique([ownerUserId, tripId, fingerprint, lifecycleGeneration])
  @@index([ownerUserId, tripId, status, lastSeenAt(sort: Desc)])
  @@index([tripId, fingerprint, resolvedAt])
}

model DayOccurrence {
  id                   String                   @id @default(uuid()) @db.Uuid
  tripId               String                   @db.Uuid
  localDate            DateTime                 @db.Date
  sequence             Int
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)
  trip                 Trip                     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  nodes                ItineraryNode[]
  transportProjections TransportDayProjection[]

  @@unique([tripId, sequence])
  @@unique([id, tripId])
  @@index([tripId, localDate])
}

model DateOwnership {
  ownerUserId String   @db.Uuid
  localDate   DateTime @db.Date
  tripId      String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trip        Trip     @relation(fields: [tripId, ownerUserId], references: [id, ownerUserId], onDelete: Cascade)

  @@id([ownerUserId, localDate])
  @@unique([tripId, localDate])
  @@index([tripId, localDate])
}

model Place {
  id          String          @id @default(uuid()) @db.Uuid
  ownerUserId String          @db.Uuid
  name        String          @db.VarChar(200)
  latitude    Decimal         @db.Decimal(9, 6)
  longitude   Decimal         @db.Decimal(9, 6)
  address     String?         @db.VarChar(500)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  owner       User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  visits      ItineraryNode[]

  @@index([ownerUserId, createdAt, id])
}

model ItineraryNode {
  id                     String                   @id @default(uuid()) @db.Uuid
  tripId                 String                   @db.Uuid
  dayOccurrenceId        String                   @db.Uuid
  kind                   ItineraryNodeKind
  position               Int
  placeId                String?                  @db.Uuid
  note                   String?                  @db.VarChar(2000)
  source                 ItineraryNodeSource      @default(USER_PLANNED)
  adoptedRouteId         String?                  @db.Uuid
  provider               String?                  @db.VarChar(100)
  providerPlaceRef       String?                  @db.VarChar(300)
  providerHubRef         String?                  @db.VarChar(300)
  sourceOperationId      String?                  @db.Uuid
  autoReplaceable        Boolean                  @default(false)
  userModifiedAt         DateTime?                @db.Timestamptz(3)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
  trip                   Trip                     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayOccurrence          DayOccurrence            @relation(fields: [dayOccurrenceId, tripId], references: [id, tripId], onDelete: Cascade)
  place                  Place?                   @relation(fields: [placeId], references: [id], onDelete: Restrict)
  temporalValues         TemporalValue[]
  timeIntents            UserTimeIntent[]
  systemDwellSuggestion  SystemDwellSuggestion?
  routeSnapshotsFrom     RouteCandidateSnapshot[] @relation("RouteSnapshotFromNode")
  routeSnapshotsTo       RouteCandidateSnapshot[] @relation("RouteSnapshotToNode")
  adoptedRoute           AdoptedRoute?            @relation("GeneratedRouteNodes", fields: [adoptedRouteId], references: [id], onDelete: SetNull)
  adoptedRouteAnchorFrom AdoptedRoute[]           @relation("AdoptedRouteFromAnchor")
  adoptedRouteAnchorTo   AdoptedRoute[]           @relation("AdoptedRouteToAnchor")
  executionEvents        ExecutionEvent[]
  executionState         NodeExecutionState?
  locationStatesCurrent  ExecutionLocationState[] @relation("ExecutionLocationCurrentNode")
  locationStatesTarget   ExecutionLocationState[] @relation("ExecutionLocationTargetNode")

  @@unique([dayOccurrenceId, position])
  @@unique([id, tripId])
  @@index([tripId, dayOccurrenceId, position])
  @@index([placeId])
  @@index([adoptedRouteId])
  @@index([provider, providerPlaceRef])
  @@index([provider, providerHubRef])
}

model RouteCandidateSnapshot {
  id                   String         @id @default(uuid()) @db.Uuid
  ownerUserId          String         @db.Uuid
  tripId               String         @db.Uuid
  basisVersion         Int
  fromNodeId           String         @db.Uuid
  toNodeId             String         @db.Uuid
  provider             String         @db.VarChar(100)
  providerCandidateRef String?        @db.VarChar(300)
  observedAt           DateTime       @db.Timestamptz(3)
  providerValidUntil   DateTime?      @db.Timestamptz(3)
  candidatePayload     Json           @db.JsonB
  candidateHash        String         @db.VarChar(64)
  queryTimeCondition   Json           @db.JsonB
  createdAt            DateTime       @db.Timestamptz(3)
  expiresAt            DateTime       @db.Timestamptz(3)
  owner                User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trip                 Trip           @relation(fields: [tripId, ownerUserId], references: [id, ownerUserId], onDelete: Cascade)
  fromNode             ItineraryNode  @relation("RouteSnapshotFromNode", fields: [fromNodeId, tripId], references: [id, tripId], onDelete: Cascade)
  toNode               ItineraryNode  @relation("RouteSnapshotToNode", fields: [toNodeId, tripId], references: [id, tripId], onDelete: Cascade)
  previews             RoutePreview[]
  adoptedRoutes        AdoptedRoute[]

  @@unique([id, tripId, ownerUserId])
  @@index([ownerUserId, tripId, expiresAt])
  @@index([expiresAt])
}

model RoutePreview {
  id                  String                 @id @default(uuid()) @db.Uuid
  ownerUserId         String                 @db.Uuid
  tripId              String                 @db.Uuid
  basisVersion        Int
  candidateSnapshotId String                 @db.Uuid
  candidateHash       String                 @db.VarChar(64)
  policyVersion       String                 @db.VarChar(100)
  previewPayload      Json                   @db.JsonB
  previewHash         String?                @db.VarChar(64)
  createdAt           DateTime               @db.Timestamptz(3)
  expiresAt           DateTime               @db.Timestamptz(3)
  owner               User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trip                Trip                   @relation(fields: [tripId, ownerUserId], references: [id, ownerUserId], onDelete: Cascade)
  candidateSnapshot   RouteCandidateSnapshot @relation(fields: [candidateSnapshotId, tripId, ownerUserId], references: [id, tripId, ownerUserId], onDelete: Cascade)
  adoptedRoutes       AdoptedRoute[]
  operationReceipts   OperationReceipt[]

  @@unique([id, tripId, ownerUserId])
  @@index([ownerUserId, tripId, expiresAt])
  @@index([expiresAt])
  @@index([candidateSnapshotId])
}

model UserTimeIntent {
  id              String                 @id @default(uuid()) @db.Uuid
  tripId          String                 @db.Uuid
  nodeId          String                 @db.Uuid
  kind            UserTimeIntentKind
  pointKind       TemporalPointKind?
  operator        UserTimeIntentOperator
  instant         DateTime?              @db.Timestamptz(3)
  timeZone        String?                @db.VarChar(100)
  durationSeconds Int?
  locked          Boolean                @default(false)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  trip            Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  node            ItineraryNode          @relation(fields: [nodeId, tripId], references: [id, tripId], onDelete: Cascade)

  @@index([tripId, nodeId])
  @@index([nodeId, kind, pointKind, operator])
}

model SystemDwellSuggestion {
  id              String                @id @default(uuid()) @db.Uuid
  tripId          String                @db.Uuid
  nodeId          String                @unique @db.Uuid
  durationSeconds Int
  source          DwellSuggestionSource @default(SYSTEM_SUGGESTION)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  trip            Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  node            ItineraryNode         @relation(fields: [nodeId, tripId], references: [id, tripId], onDelete: Cascade)

  @@unique([nodeId, tripId])
  @@index([tripId, nodeId])
}

model TransportEdge {
  id             String                   @id @default(uuid()) @db.Uuid
  tripId         String                   @db.Uuid
  fromNodeId     String                   @db.Uuid
  toNodeId       String                   @db.Uuid
  mode           TransportMode
  fixedService   Boolean
  serviceLabel   String?                  @db.VarChar(200)
  note           String?                  @db.VarChar(2000)
  source         TransportSource          @default(MANUAL)
  adoptedRouteId String?                  @db.Uuid
  provider       String?                  @db.VarChar(100)
  providerRef    String?                  @db.VarChar(300)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
  trip           Trip                     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  temporalValues TemporalValue[]
  adoptedRoute   AdoptedRoute?            @relation(fields: [adoptedRouteId], references: [id], onDelete: SetNull)
  dayProjections TransportDayProjection[]
  flightBinding  FlightBinding?

  @@unique([tripId, fromNodeId, toNodeId])
  @@unique([tripId, fromNodeId])
  @@unique([tripId, toNodeId])
  @@unique([id, tripId])
  @@index([tripId, createdAt, id])
  @@index([adoptedRouteId])
}

model FlightBinding {
  id                    String              @id @default(uuid()) @db.Uuid
  ownerUserId           String              @db.Uuid
  tripId                String              @db.Uuid
  transportEdgeId       String              @unique @db.Uuid
  provider              String              @db.VarChar(100)
  providerFlightRef     String              @db.VarChar(300)
  canonicalFlightNumber String              @db.VarChar(16)
  displayFlightNumber   String              @db.VarChar(32)
  serviceDate           DateTime            @db.Date
  selectedSnapshot      Json                @db.JsonB
  latestSnapshot        Json                @db.JsonB
  status                FlightStatus
  lastRefreshedAt       DateTime            @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)
  owner                 User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trip                  Trip                @relation(fields: [tripId, ownerUserId], references: [id, ownerUserId], onDelete: Cascade)
  transportEdge         TransportEdge       @relation(fields: [transportEdgeId, tripId], references: [id, tripId], onDelete: Cascade)
  monitorState          FlightMonitorState?

  @@unique([id, tripId, ownerUserId])
  @@unique([transportEdgeId, tripId])
  @@index([ownerUserId, tripId, updatedAt(sort: Desc)])
  @@index([provider, canonicalFlightNumber, serviceDate])
}

model FlightMonitorState {
  flightBindingId                String            @id @db.Uuid
  generation                     String            @default(uuid()) @db.Uuid
  mode                           FlightMonitorMode @default(NORMAL)
  arrivedAtAirportAt             DateTime?         @db.Timestamptz(3)
  arrivedAirportIata             String?           @db.VarChar(3)
  lastSuccessfulMonitorRefreshAt DateTime?         @db.Timestamptz(3)
  lastDecisionFetchedAt          DateTime?         @db.Timestamptz(3)
  lastDecisionSnapshot           Json?
  lastNotifiedDelayMinutes       Int?
  earlyDepartureNotified         Boolean           @default(false)
  lastNotifiedDepartureGate      String?           @db.VarChar(100)
  providerUnavailableWarned      Boolean           @default(false)
  cancellationNotified           Boolean           @default(false)
  baggageWindowStartedAt         DateTime?         @db.Timestamptz(3)
  baggageWindowEndsAt            DateTime?         @db.Timestamptz(3)
  lastNotifiedBaggage            String?           @db.VarChar(100)
  createdAt                      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime          @updatedAt @db.Timestamptz(3)
  flightBinding                  FlightBinding     @relation(fields: [flightBindingId], references: [id], onDelete: Cascade)
}

model TransportEdgeHistory {
  id                      String                          @id @default(uuid()) @db.Uuid
  originalTransportEdgeId String                          @unique @db.Uuid
  tripId                  String                          @db.Uuid
  originalFromNodeId      String                          @db.Uuid
  originalToNodeId        String                          @db.Uuid
  mode                    TransportMode
  fixedService            Boolean
  serviceLabel            String?                         @db.VarChar(200)
  note                    String?                         @db.VarChar(2000)
  source                  TransportSource
  adoptedRouteId          String?                         @db.Uuid
  provider                String?                         @db.VarChar(100)
  providerRef             String?                         @db.VarChar(300)
  originalCreatedAt       DateTime                        @db.Timestamptz(3)
  invalidatedAt           DateTime                        @default(now()) @db.Timestamptz(3)
  invalidationReason      TransportInvalidationReason
  trip                    Trip                            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  temporalValues          TransportEdgeHistoryTimeValue[]

  @@index([tripId, invalidatedAt(sort: Desc), id(sort: Desc)])
  @@index([originalFromNodeId, originalToNodeId])
  @@index([adoptedRouteId])
}

model AdoptedRoute {
  id                  String                 @id @default(uuid()) @db.Uuid
  tripId              String                 @db.Uuid
  anchorFromNodeId    String                 @db.Uuid
  anchorToNodeId      String                 @db.Uuid
  sourcePreviewId     String                 @unique @db.Uuid
  candidateSnapshotId String                 @db.Uuid
  candidateHash       String                 @db.VarChar(64)
  policyVersion       String                 @db.VarChar(100)
  status              AdoptedRouteStatus     @default(ACTIVE)
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  replacedAt          DateTime?              @db.Timestamptz(3)
  undoneAt            DateTime?              @db.Timestamptz(3)
  trip                Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  anchorFrom          ItineraryNode          @relation("AdoptedRouteFromAnchor", fields: [anchorFromNodeId, tripId], references: [id, tripId], onDelete: Restrict)
  anchorTo            ItineraryNode          @relation("AdoptedRouteToAnchor", fields: [anchorToNodeId, tripId], references: [id, tripId], onDelete: Restrict)
  sourcePreview       RoutePreview           @relation(fields: [sourcePreviewId], references: [id], onDelete: Restrict)
  candidateSnapshot   RouteCandidateSnapshot @relation(fields: [candidateSnapshotId], references: [id], onDelete: Restrict)
  generatedNodes      ItineraryNode[]        @relation("GeneratedRouteNodes")
  transportEdges      TransportEdge[]
  operationReceipts   OperationReceipt[]

  @@unique([id, tripId])
  @@index([tripId, status, anchorFromNodeId, anchorToNodeId])
}

model TransportDayProjection {
  id              String                     @id @default(uuid()) @db.Uuid
  tripId          String                     @db.Uuid
  transportEdgeId String                     @db.Uuid
  dayOccurrenceId String                     @db.Uuid
  role            TransportDayProjectionRole
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)
  trip            Trip                       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  transportEdge   TransportEdge              @relation(fields: [transportEdgeId, tripId], references: [id, tripId], onDelete: Cascade)
  dayOccurrence   DayOccurrence              @relation(fields: [dayOccurrenceId, tripId], references: [id, tripId], onDelete: Cascade)

  @@unique([transportEdgeId, dayOccurrenceId])
  @@index([tripId, dayOccurrenceId, role])
}

model OperationReceipt {
  id                       String            @id @default(uuid()) @db.Uuid
  ownerUserId              String            @db.Uuid
  tripId                   String            @db.Uuid
  operationType            OperationType
  idempotencyKey           String            @db.VarChar(200)
  requestHash              String            @db.VarChar(64)
  baseTripVersion          Int
  resultingTripVersion     Int
  previewId                String            @db.Uuid
  adoptedRouteId           String            @db.Uuid
  targetOperationReceiptId String?           @unique @db.Uuid
  undoExpiresAt            DateTime?         @db.Timestamptz(3)
  delta                    Json              @db.JsonB
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)
  owner                    User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trip                     Trip              @relation(fields: [tripId, ownerUserId], references: [id, ownerUserId], onDelete: Cascade)
  preview                  RoutePreview      @relation(fields: [previewId], references: [id], onDelete: Restrict)
  adoptedRoute             AdoptedRoute      @relation(fields: [adoptedRouteId], references: [id], onDelete: Restrict)
  targetOperationReceipt   OperationReceipt? @relation("OperationUndoTarget", fields: [targetOperationReceiptId], references: [id], onDelete: Restrict)
  undoReceipt              OperationReceipt? @relation("OperationUndoTarget")
  outboxEvents             OutboxEvent[]

  @@unique([ownerUserId, tripId, operationType, idempotencyKey])
  @@index([ownerUserId, tripId, createdAt(sort: Desc)])
}

model OutboxEvent {
  id                 String           @id @default(uuid()) @db.Uuid
  type               OutboxEventType
  aggregateType      String           @db.VarChar(100)
  aggregateId        String           @db.Uuid
  tripId             String           @db.Uuid
  operationReceiptId String           @db.Uuid
  payload            Json             @db.JsonB
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  processedAt        DateTime?        @db.Timestamptz(3)
  trip               Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  operationReceipt   OperationReceipt @relation(fields: [operationReceiptId], references: [id], onDelete: Cascade)

  @@unique([operationReceiptId, type])
  @@index([processedAt, createdAt])
}

model TemporalValue {
  id              String             @id @default(uuid()) @db.Uuid
  nodeId          String?            @db.Uuid
  transportEdgeId String?            @db.Uuid
  layer           TemporalLayer
  pointKind       TemporalPointKind
  instant         DateTime           @db.Timestamptz(3)
  timeZone        String             @db.VarChar(100)
  sourceKind      TemporalSourceKind
  sourceRef       String?            @db.VarChar(300)
  observedAt      DateTime?          @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)
  node            ItineraryNode?     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  transportEdge   TransportEdge?     @relation(fields: [transportEdgeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, pointKind, layer])
  @@unique([transportEdgeId, pointKind, layer])
  @@index([nodeId])
  @@index([transportEdgeId])
}

model ExecutionEvent {
  id                        String               @id @default(uuid()) @db.Uuid
  ownerUserId               String               @db.Uuid
  tripId                    String               @db.Uuid
  nodeId                    String               @db.Uuid
  type                      ExecutionEventType
  source                    ExecutionEventSource
  occurredAt                DateTime             @db.Timestamptz(3)
  idempotencyKey            String?              @db.VarChar(200)
  requestHash               String?              @db.VarChar(64)
  undoneAt                  DateTime?            @db.Timestamptz(3)
  undoIdempotencyKey        String?              @db.VarChar(200)
  undoRequestHash           String?              @db.VarChar(64)
  airportTriggerCompletedAt DateTime?            @db.Timestamptz(3)
  createdAt                 DateTime             @default(now()) @db.Timestamptz(3)
  owner                     User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  trip                      Trip                 @relation(fields: [tripId, ownerUserId], references: [id, ownerUserId], onDelete: Cascade)
  node                      ItineraryNode        @relation(fields: [nodeId, tripId], references: [id, tripId], onDelete: Cascade)
  detectedNodeStates        NodeExecutionState[]

  @@unique([ownerUserId, idempotencyKey])
  @@unique([ownerUserId, undoIdempotencyKey])
  @@unique([id, tripId])
  @@index([ownerUserId, tripId, createdAt(sort: Desc)])
  @@index([tripId, nodeId, type, undoneAt])
}

model ExecutionLocationState {
  tripId                              String                  @id @db.Uuid
  currentNodeId                       String?                 @db.Uuid
  targetNodeId                        String?                 @db.Uuid
  lastObservedAt                      DateTime                @db.Timestamptz(3)
  lastDistanceToCurrentTargetMeters   Float?
  lastDistanceToNextTargetMeters      Float?
  outsideTargetConsecutiveCount       Int                     @default(0)
  locationStatus                      ExecutionLocationStatus
  updatedAt                           DateTime                @updatedAt @db.Timestamptz(3)
  trip                                Trip                    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  currentNode                         ItineraryNode?          @relation("ExecutionLocationCurrentNode", fields: [currentNodeId, tripId], references: [id, tripId], onDelete: Cascade)
  targetNode                          ItineraryNode?          @relation("ExecutionLocationTargetNode", fields: [targetNodeId, tripId], references: [id, tripId], onDelete: Cascade)

  @@index([currentNodeId])
  @@index([targetNodeId])
}

model NodeExecutionState {
  nodeId            String              @id @db.Uuid
  tripId            String              @db.Uuid
  status            NodeExecutionStatus
  detectedByEventId String?             @db.Uuid
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  node              ItineraryNode       @relation(fields: [nodeId, tripId], references: [id, tripId], onDelete: Cascade)
  detectedByEvent   ExecutionEvent?     @relation(fields: [detectedByEventId], references: [id], onDelete: SetNull)

  @@unique([nodeId, tripId])
  @@index([tripId, status])
  @@index([detectedByEventId])
}

model TransportEdgeHistoryTimeValue {
  id                     String               @id @default(uuid()) @db.Uuid
  transportEdgeHistoryId String               @db.Uuid
  layer                  TemporalLayer
  pointKind              TemporalPointKind
  instant                DateTime             @db.Timestamptz(3)
  timeZone               String               @db.VarChar(100)
  sourceKind             TemporalSourceKind
  sourceRef              String?              @db.VarChar(300)
  observedAt             DateTime?            @db.Timestamptz(3)
  originalCreatedAt      DateTime             @db.Timestamptz(3)
  originalUpdatedAt      DateTime             @db.Timestamptz(3)
  history                TransportEdgeHistory @relation(fields: [transportEdgeHistoryId], references: [id], onDelete: Cascade)

  @@unique([transportEdgeHistoryId, pointKind, layer])
  @@index([transportEdgeHistoryId])
}
