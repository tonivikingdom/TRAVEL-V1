APP_ENV=development
ENABLE_GOOGLE_CONSUMER_TRANSIT=false
LOCAL_TRANSIT_API_TOKEN=CHANGE_ME_USE_TOKEN_COMMAND_OR_SECRET_STORE
GOOGLE_TRANSIT_HOST=127.0.0.1
GOOGLE_TRANSIT_PORT=8787
GOOGLE_TRANSIT_EXECUTABLE_PATH=/usr/bin/chromium
GOOGLE_TRANSIT_HEADLESS=true
GOOGLE_TRANSIT_TIMEOUT_MS=45000
MAX_CONCURRENT_SEARCHES=1
