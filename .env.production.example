# Shape documentation only. P0 does not deploy production.
NODE_ENV=production
APP_ENV=production
API_HOST=127.0.0.1
API_PORT=3200
DATABASE_URL=CHANGE_ME_USE_SECRET_MANAGER
AUTH_MAGIC_LINK_LANDING_URL=CHANGE_ME_PRODUCTION_HTTPS_LANDING_URL
MAIL_PROVIDER=unconfigured
ROUTE_PROVIDER=unconfigured
ROUTE_CANDIDATE_SNAPSHOT_TTL_SECONDS=900
ROUTE_PREVIEW_TTL_SECONDS=600
ROUTE_UNDO_WINDOW_SECONDS=CHANGE_ME_PRODUCTION_EXPLICIT_WINDOW
# A real production route provider adapter and credentials remain unconfigured.
MAGIC_LINK_TTL_SECONDS=CHANGE_ME
SESSION_TTL_SECONDS=CHANGE_ME
INVITATION_TTL_SECONDS=CHANGE_ME
MAGIC_LINK_RATE_LIMIT_WINDOW_SECONDS=CHANGE_ME
MAGIC_LINK_RATE_LIMIT_MAX_REQUESTS=CHANGE_ME
DEFAULT_BASE_CURRENCY=CNY
DEFAULT_UI_LANGUAGE=zh-CN
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_MAX_AGE_MS=30000
# Local filesystem object storage is prohibited in production. A real provider
# and explicit limits remain unconfigured and production deployment is unauthorized.
OBJECT_MAX_FILE_BYTES=CHANGE_ME_PRODUCTION_EXPLICIT_LIMIT
OBJECT_MAX_USER_TOTAL_BYTES=CHANGE_ME_PRODUCTION_EXPLICIT_LIMIT
OBJECT_ALLOWED_MEDIA_TYPES=CHANGE_ME_PRODUCTION_EXPLICIT_ALLOWLIST

