# Configuration SHAPE ONLY. Never put real credentials in this template or files.
# Inject all four credentials through environment variables only.
# Google Server: Places API (New), Routes API. Server-only; never VITE_ prefix.
GOOGLE_SERVER_API_KEY=
# Google Browser: Maps JavaScript API; public domain-restricted browser key.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Baidu Server: Place, walking, current driving, transit, cycling, future driving.
# Future driving needs separate advanced account entitlement (not proved by HTTP 200).
BAIDU_SERVER_API_KEY=
# Baidu Browser: JSAPI 4.0 and official JS coordinate conversion, separate from server AK.
VITE_BAIDU_MAPS_BROWSER_KEY=

# Reviewed permissions, not credential presence. All remain false by default.
# Doctor --live is isolated dev/test acceptance; it never changes these gates.
GOOGLE_LIVE_API_ENABLED=false
GOOGLE_ENTITLEMENT_APPROVED=false
GOOGLE_STORAGE_APPROVED=false
GOOGLE_ATTRIBUTION_APPROVED=false
BAIDU_LIVE_API_ENABLED=false
BAIDU_ENTITLEMENT_APPROVED=false
BAIDU_STORAGE_APPROVED=false
BAIDU_ATTRIBUTION_APPROVED=false
BAIDU_COORDINATES_APPROVED=false
BAIDU_FUTURE_DRIVING_APPROVED=false
VITE_GOOGLE_MAPS_EMBED_ENABLED=false
VITE_GOOGLE_MAPS_ENTITLEMENT_APPROVED=false
VITE_GOOGLE_MAPS_STORAGE_APPROVED=false
VITE_GOOGLE_MAPS_ATTRIBUTION_APPROVED=false
VITE_BAIDU_MAPS_EMBED_ENABLED=false
VITE_BAIDU_MAPS_ENTITLEMENT_APPROVED=false
VITE_BAIDU_MAPS_STORAGE_APPROVED=false
VITE_BAIDU_MAPS_ATTRIBUTION_APPROVED=false
VITE_BAIDU_MAPS_COORDINATES_APPROVED=false

# Non-secret server/runtime selection: ROUTE_PROVIDER=regional (set deliberately).
# Japan Transit keeps the existing independently configured sidecar.
# Baidu ARRIVE_BY is unsupported; never infer it from current traffic duration.
