# Template only. Replace every CHANGE_ME value outside Git before staging use.
COMPOSE_PROJECT_NAME=travel-v1-staging
APP_ENV=staging
API_PORT=3100
AUTH_MAGIC_LINK_LANDING_URL=CHANGE_ME_STAGING_HTTPS_LANDING_URL
POSTGRES_DB=travel_staging
POSTGRES_USER=travel_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_SECRET
POSTGRES_HOST_PORT=54322
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_MAX_AGE_MS=30000
MAIL_PROVIDER=unconfigured
# Replace with canonical base64url or hex for >=32 cryptographically generated bytes.
MAGIC_LINK_TOKEN_KEY=CHANGE_ME_STAGING_32_BYTE_ENCODED_SECRET_OUTSIDE_GIT
MAGIC_LINK_TTL_SECONDS=900
JOB_MAX_ATTEMPTS=5
JOB_LEASE_DURATION_MS=30000
JOB_POLL_INTERVAL_MS=1000
JOB_RETRY_BASE_DELAY_MS=1000
JOB_RETRY_MAX_DELAY_MS=300000
JOB_EXECUTION_TIMEOUT_MS=15000
WORKER_SHUTDOWN_TIMEOUT_MS=10000
SESSION_TTL_SECONDS=2592000
INVITATION_TTL_SECONDS=604800
MAGIC_LINK_RATE_LIMIT_WINDOW_SECONDS=300
MAGIC_LINK_RATE_LIMIT_MAX_REQUESTS=5
DEFAULT_BASE_CURRENCY=CNY
DEFAULT_UI_LANGUAGE=zh-CN
# Real staging email remains blocked until a provider adapter and credentials are supplied outside Git.

